{
  "name": "@woms/api",
  "version": "0.3.0",
  "private": true,
  "description": "WOMS Backend Core (TV4): NestJS + Prisma + PostgreSQL, JWT/RBAC, Workflow Engine, SLA, Transactional Outbox",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "npm run build && node --watch-path=dist --enable-source-maps dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/seed.js",
    "test:integration": "npm run build && vitest run",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "@woms/domain": "*",
    "bcryptjs": "^3.0.3",
    "helmet": "^8.1.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  }
}
